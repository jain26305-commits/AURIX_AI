# AURIX deployment environment template
AURIX_ENVIRONMENT=production

# Database
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE
ALEMBIC_DATABASE_URL=
DATABASE_DISABLE_PREPARED_STATEMENTS=false

# Database connection/pool hardening
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Authentication / security
API_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DEBUG=false
ENABLE_DOCS=false
CORS_ORIGINS=https://your-frontend.example.com

# Optional AI providers
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Durable model/artifact storage
ARTIFACT_STORAGE_PATH=./artifacts
ARTIFACT_STORAGE_BACKEND=supabase
ARTIFACT_STORAGE_BUCKET=aurix-artifacts
ARTIFACT_STORAGE_PREFIX=models
ARTIFACT_STORAGE_TIMEOUT_SECONDS=30
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=